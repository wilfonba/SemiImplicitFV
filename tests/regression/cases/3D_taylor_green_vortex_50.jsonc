{
    // 3D Taylor-Green Vortex — explicit solver regression test
    // Coarse 40x40x40 mesh, 50 steps with fixed dt
    "config": {
        "dim": 3,
        "RKOrder": 3,
        "reconOrder": "WENO5",
        "semiImplicit": false,
        "explicitParams": { "constDt": 0.005 },
        "viscousParams": { "mu": 0.000625 }
    },
    "eos": { "type": "IdealGas", "gamma": 1.4, "R": 1.0 },
    "riemannSolver": "HLLC",
    "mesh": {
        "nx": 40, "xMin": 0.0, "xMax": 6.283185307179586,
        "ny": 40, "yMin": 0.0, "yMax": 6.283185307179586,
        "nz": 40, "zMin": 0.0, "zMax": 6.283185307179586
    },
    "boundaryConditions": {
        "xLow": "Periodic", "xHigh": "Periodic",
        "yLow": "Periodic", "yHigh": "Periodic",
        "zLow": "Periodic", "zHigh": "Periodic"
    },
    "timeLoop": { "endTime": 0.25, "outputInterval": 1e10, "printInterval": 100000 },
    "initialConditions": {
        "default": { "rho": 1.0, "u": 0.0, "v": 0.0, "w": 0.0, "p": 71.4285714285714 },
        "patches": [
            {
                "geometry": { "type": "analytic" },
                "expressions": {
                    "u":  "sin(x) * cos(y) * sin(z)",
                    "v":  "-cos(x) * sin(y) * sin(z)",
                    "p":  "71.4285714285714 + (1.0/16.0) * (cos(2*x) + cos(2*y)) * (cos(2*z) + 2)"
                }
            }
        ]
    }
}
