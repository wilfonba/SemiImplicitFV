{
    // 2D Rising Bubble — Hysing et al. (2009), Test Case 2
    // Re = 35, Eo = 125
    "config": {
        "dim": 2,
        "nGhost": 3,
        "RKOrder": 3,
        "reconOrder": "WENO5",
        "semiImplicit": false,
        "explicitParams": { "cfl": 0.5 },
        "multiPhaseParams": {
            "nPhases": 2,
            "phases": [
                { "gamma": 6.12, "pInf": 3.43e8 },
                { "gamma": 1.4,  "pInf": 0.0 }
            ],
            "alphaMin": 1e-8
        },
        "bodyForceParams": { "a": [0, -0.98, 0] },
        "viscousParams": { "phaseMu": [10.0, 0.1] },
        "surfaceTensionParams": { "sigma": 1.96 }
    },
    "eos": { "type": "IdealGas", "gamma": 1.4, "R": 287.0 },
    "riemannSolver": "HLLC",
    "mesh": {
        "nx": 40, "xMin": 0.0, "xMax": 1.0,
        "ny": 80, "yMin": 0.0, "yMax": 2.0
    },
    "boundaryConditions": {
        "xLow": "SlipWall", "xHigh": "SlipWall",
        "yLow": "NoSlipWall", "yHigh": "NoSlipWall"
    },
    "timeLoop": { "endTime": 3.0, "outputInterval": 0.03, "printInterval": 50 },
    "output": { "baseName": "2D_rising_bubble" },
    "initialConditions": {
        // Default: heavy fluid everywhere
        // Hydrostatic pressure: p(y) = pRef + rhoHeavy * |g| * (Ly - y)
        "default": {
            "rho": 1000.0, "u": 0.0, "v": 0.0, "p": 1.0e6,
            "alpha": [0.99999999, 1e-8],
            "alphaRho": [999.99999, 0.001]
        },
        "patches": [
            {
                // Hydrostatic pressure everywhere
                "geometry": { "type": "analytic" },
                "expressions": {
                    "p": "1e6 + 980 * (2.0 - y)"
                }
            },
            {
                // Light bubble at center with diffuse interface
                "geometry": { "type": "sphere", "center": [0.5, 0.5, 0], "radius": 0.25 },
                "state": {
                    "rho": 1.0, "p": 1.0e6,
                    "alpha": [1e-8, 0.99999999],
                    "alphaRho": [0.001, 0.99999999]
                },
                "interface": { "diffuseWidth": 3, "profile": "tanh" }
            }
        ]
    }
}
