{
    // 2D Rising Bubble — Hysing et al. (2009), Test Case 2
    // Re = 35, Eo = 125
    "config": {
        "dim": 2,
        "RKOrder": 3,
        "reconOrder": "WENO5",
        "semiImplicit": true,
        //"explicitParams": { "cfl": 0.5 },
        "semiImplicitParams": {
            "cfl": 0.8,
            "maxDt": 1e-3,
            "maxPressureIters": 200,
            "pressureTol": 1e-10,
            "maxAcousticCFL": 20
        },
        "multiPhaseParams": {
            "nPhases": 2,
            "phases": [
                { "gamma": 6.12, "pInf": 3.43e8 },
                { "gamma": 1.4,  "pInf": 0.0 }
            ],
            "alphaMin": 1e-8
        },
        "bodyForceParams": { "a": [0, -0.98, 0] },
        "viscousParams": { "phaseMu": [10.0, 0.1] },
        "surfaceTensionParams": { "sigma": 1.96 },
        "mthincParams": { "enabled": true, "beta": 0.75 }
    },
    "eos": { "type": "IdealGas", "gamma": 1.4, "R": 287.0 },
    "riemannSolver": "HLLC",
    "pressureSolver": "PETSc",
    "mesh": {
        "nx": 400, "xMin": 0.0, "xMax": 1.0,
        "ny": 800, "yMin": 0.0, "yMax": 2.0
    },
    "boundaryConditions": {
        "xLow": "SlipWall", "xHigh": "SlipWall",
        "yLow": "NoSlipWall", "yHigh": "NoSlipWall"
    },
    "timeLoop": { "endTime": 3.0, "outputInterval": 0.03, "printInterval": 1 },
    "restart": {
        "checkpoint": true
        //"file": "Checkpoint/checkpoint.{rank}.bin"
    },
    "output": {
        "baseName": "2D_rising_bubble",
        "format": "VTKRaw"
    },
    "initialConditions": {
        // Default: heavy fluid everywhere
        // Hydrostatic pressure: p(y) = pRef + rhoHeavy * |g| * (Ly - y)
        "default": {
            "rho": 1000.0, "u": 0.0, "v": 0.0, "p": 1.0e6,
            "alpha": [0.99999999, 1e-8],
            "alphaRho": [999.99999, 0.001]
        },
        "patches": [
            {
                // Hydrostatic pressure everywhere
                "geometry": { "type": "analytic" },
                "expressions": {
                    "p": "1e5 + 980 * (2.0 - y)"
                }
            },
            {
                // Light bubble at center
                "geometry": { "type": "sphere", "center": [0.5, 0.5, 0], "radius": 0.25 },
                "state": {
                    "rho": 1.0, "p": 1.0e5,
                    "alpha": [1e-8, 0.99999999],
                    "alphaRho": [0.001, 0.99999999]
                }
            }
        ]
    },
    "smoothing": { "iterations": 25 }
}
