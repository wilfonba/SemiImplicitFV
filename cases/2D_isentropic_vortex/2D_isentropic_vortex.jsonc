{
    // 2D Isentropic Vortex — Shu (1998), periodic advection
    // Matches examples/2D_isentropic_vortex
    //
    // Parameters: gamma=1.4, R=1.0, rhoInf=1.0, Mach=0.1, beta=5.0
    // Tinf = pInf/(rhoInf*R) = 142.857142857143
    // pInf = 2/(gamma*Mach^2) = 142.857142857143
    "config": {
        "dim": 2,
        "RKOrder": 3,
        "reconOrder": "WENO3",
        "semiImplicit": true,
        "semiImplicitParams": {
            "cfl": 0.5, "maxDt": 1.0,
            "pressureTol": 1e-8, "maxPressureIters": 500
        }
    },
    "eos": { "type": "IdealGas", "gamma": 1.4, "R": 1.0 },
    "riemannSolver": "HLLC",
    "mesh": {
        "nx": 128, "xMin": 0.0, "xMax": 10.0,
        "ny": 128, "yMin": 0.0, "yMax": 10.0
    },
    "boundaryConditions": {
        "xLow": "Periodic", "xHigh": "Periodic",
        "yLow": "Periodic", "yHigh": "Periodic"
    },
    "timeLoop": { "endTime": 10.0, "outputInterval": 1.0, "printInterval": 20 },
    "output": { "baseName": "2D_isentropic_vortex" },
    "initialConditions": {
        "default": { "rho": 1.0, "u": 1.0, "v": 1.0, "p": 142.857142857143 },
        "patches": [
            {
                // Isentropic vortex perturbation (exprtk local vars)
                // beta=5, xc=5, yc=5, gamma=1.4, Tinf=142.857142857143
                "geometry": { "type": "analytic" },
                "expressions": {
                    "rho": "var r := sqrt((x-5)^2 + (y-5)^2); var f := exp((1 - r^2)/2); var dT := -10 / (8 * 1.4 * pi^2) * f^2; var Tinf := 142.857142857143; var T := Tinf + dT; (T / Tinf)^2.5",
                    "u":   "var r := sqrt((x-5)^2 + (y-5)^2); var f := exp((1 - r^2)/2); 1.0 + (-5 / (2*pi)) * (y - 5) * f",
                    "v":   "var r := sqrt((x-5)^2 + (y-5)^2); var f := exp((1 - r^2)/2); 1.0 + ( 5 / (2*pi)) * (x - 5) * f",
                    "p":   "var r := sqrt((x-5)^2 + (y-5)^2); var f := exp((1 - r^2)/2); var dT := -10 / (8 * 1.4 * pi^2) * f^2; var Tinf := 142.857142857143; var T := Tinf + dT; var rho := (T / Tinf)^2.5; rho * T"
                }
            }
        ]
    }
}
