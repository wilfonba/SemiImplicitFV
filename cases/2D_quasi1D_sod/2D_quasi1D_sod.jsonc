{
    // 2D Quasi-1D Sod Shock Tube — Sod problem in x-direction on a 2D mesh
    // Matches examples/2D_quasi1D_sod
    "config": {
        "dim": 2,
        "RKOrder": 3,
        "reconOrder": "UPWIND5",
        "useIGR": true,
        "explicitParams": { "cfl": 0.1 },
        "igrParams": { "alphaCoeff": 10.0, "IGRIters": 5 }
    },
    "eos": { "type": "IdealGas", "gamma": 1.4, "R": 287.0 },
    "riemannSolver": "LF",
    "mesh": {
        "nx": 200, "xMin": 0.0, "xMax": 1.0,
        "ny": 200, "yMin": 0.0, "yMax": 1.0
    },
    "boundaryConditions": {
        "xLow": "Outflow", "xHigh": "Outflow",
        "yLow": "Outflow", "yHigh": "Outflow"
    },
    "timeLoop": { "endTime": 0.2, "outputInterval": 0.002, "printInterval": 20 },
    "output": { "baseName": "quasi1D_sod" },
    "smoothing": { "iterations": 10 },
    "initialConditions": {
        "default": { "rho": 1.0, "u": 0.0, "v": 0.0, "p": 1.0 },
        "patches": [
            {
                "geometry": { "type": "plane", "point": [0.5, 0, 0], "normal": [1, 0, 0] },
                "state": { "rho": 0.125, "u": 0.0, "v": 0.0, "p": 0.1 }
            }
        ]
    }
}
